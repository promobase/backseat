{
  "browser": {
    "browserName": "chromium",
    "isolated": false,
    "userDataDir": "./tmp/browser-data",
    "storageState": "./tmp/storage-state.json",
    "launchOptions": {
      "headless": false,
      "channel": "chrome"
    },
    "contextOptions": {
      "viewport": {
        "width": 1280,
        "height": 720
      }
    }
  },
  "capabilities": [
    "core",
    "tabs",
    "pdf",
    "history",
    "wait",
    "files",
    "testing"
  ],
  "vision": true,
  "outputDir": "./output",
  "network": {
    "allowedOrigins": ["*"],
    "blockedOrigins": []
  },
  "noImageResponses": false
}
